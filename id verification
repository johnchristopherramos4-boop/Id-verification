package Bwisit;

package Bwisit;

import java.util.Scanner;
import java.util.HashMap;

public class forIDVerification {

    public static boolean Id() {
    	
    	class Person {
    	    private String name;
    	    private int age;

    	    public Person(String name, int age) {
    	        this.name = name;
    	        this.age = age;
    	    }

    	    // Getters
    	    public String getName() {
    	        return name;
    	    }

    	    public int getAge() {
    	        return age;
    	    }
    	}
        Scanner sc = new Scanner(System.in);
        HashMap<Integer, Person> IdPersons = new HashMap<>();

        IdPersons.put(9812312, new Person("Juan Dela Cruz", 65));
        IdPersons.put(1234512, new Person("Maria Clara", 70));
        IdPersons.put(6789012, new Person("Jose Rizal", 68));

        System.out.print("Do you have Senior Citizen Card? (Y or N): ");
        String answer = sc.next();

        if (answer.equalsIgnoreCase("Y")) {

            String idInput;
            int IdNumber;

            while (true) {
                System.out.print("Provide your ID number for verification: ");
                idInput = sc.next();

                if (!idInput.matches("\\d+")) {
                    System.out.println("ID must not contain characters. Please try again.");
                    continue;
                }

                IdNumber = Integer.parseInt(idInput);
                break;
            }

            System.out.println("This is your ID number: " + IdNumber);
            System.out.println("Verifying...");
            for (int i = 0; i < 5; i++) {
                try {
                    Thread.sleep(500);
                    System.out.print(".");
                } catch (InterruptedException e) {
                    e.printStackTrace();
                }
            }

            if (IdPersons.containsKey(IdNumber)) {
                Person person = IdPersons.get(IdNumber);
                System.out.println("\nVerified!");
                System.out.println("You’re: " + person.getName());
                System.out.println("Your age is: " + person.getAge());
            

                return true;
            } else {
                System.out.println("\nInvalid ID Number!");
                return false;
            }

        } else if (answer.equalsIgnoreCase("N")) {
            System.out.println("No ID. No Discount.");
            return false;
        } else {
            System.out.println("Invalid input.");
            return false;
        }
    }
}

