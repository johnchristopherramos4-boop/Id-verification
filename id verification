package Bwisit;


import java.util.Scanner;
import java.util.HashMap;

public class forIDVerification {

    public static boolean Id() {

        Scanner sc = new Scanner(System.in);
        HashMap<Integer, String> IdNames = new HashMap<>();
        IdNames.put(9812312, "Juan Dela Cruz");
        IdNames.put(1234512, "Maria Clara");
        IdNames.put(6789012, "Jose Rizal");

        System.out.print("Do you have Senior Citizen Card? (Y or N): ");
        String answer = sc.next();

        if (answer.equalsIgnoreCase("Y")) {

            String idInput;
            int IdNumber;

            while (true) {
                System.out.print("Provide your ID number for verification: ");
                idInput = sc.next();

                if (!idInput.matches("\\d+")) {
                    System.out.println("ID must not contain characters. Please try again.");
                    continue;
                }

                IdNumber = Integer.parseInt(idInput);
                break;
            }

            System.out.println("This is your ID number: " + IdNumber);
            System.out.println("Verifying...");
            for (int i = 0; i < 5; i++) {
                try {
                    Thread.sleep(500);
                    System.out.print(".");
                } catch (InterruptedException e) {
                    e.printStackTrace();
                }
            }

            if (IdNames.containsKey(IdNumber)) {
                System.out.println("\nVerified!");
                String name = IdNames.get(IdNumber);
                System.out.println("You’re: " + name);

                return true;
            } else {
                System.out.println("\nInvalid ID Number!");
                return false;
            }

        } else if (answer.equalsIgnoreCase("N")) {
            System.out.println("No ID. No Discount.");
            return false;
        } else {
            System.out.println("Invalid input.");
            return false;
        }
    }
}

