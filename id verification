package Bwisit;

import java.util.Scanner;
import java.util.ArrayList;


public class forIDVerification {

    public static boolean Id() {

        Scanner sc = new Scanner(System.in);

        ArrayList<Integer> Ids = new ArrayList<>();
        Ids.add(9812312);
        Ids.add(1234512);
        Ids.add(6789012);

        System.out.print("Do you have Discounted Card? (Y or N): ");
        String answer = sc.next();
        
        if (answer.equalsIgnoreCase("Y")) {

            System.out.print("Provide your ID number for verification: ");
            int IdNumber = sc.nextInt();
            System.out.print("This is your id number: " +IdNumber);
           
            System.out.println("Verifying...");
            for (int i = 0; i < 5; i++) {
                try {
                    Thread.sleep(500);
                    System.out.print(".");
                } catch (InterruptedException e) {}
            }

            if (Ids.contains(IdNumber)) {
                System.out.println("\nVerified!");
                return true;  
            } else {
                System.out.println("\nInvalid ID Number!");
                return false;
            }

        } 
        else if (answer.equalsIgnoreCase("N")) {
            System.out.println("No ID. No Discount.");
            return false;
        } 
        else {
            System.out.println("Invalid input.");
            return false;
        }
    }
}
